# =====================================================================
# Configuration locale du service Python - a copier vers ".env"
# (fichier non versionne, meme convention que
# backend/src/main/resources/application-local.properties)
# =====================================================================

# Cle API Google Gemini, obtenue via Google AI Studio. Meme fournisseur
# que l'EmbeddingClient Java du lot 6, mais cle dediee a ce service.
GEMINI_API_KEY=

# Modele Gemini utilise pour la generation (distinct de gemini-embedding-2,
# utilise cote Java uniquement pour les embeddings).
GEMINI_MODEL=gemini-3.6-flash

# Delai maximal (secondes) avant d'abandonner un appel a Gemini.
GEMINI_TIMEOUT_SECONDS=60

LOG_LEVEL=INFO
