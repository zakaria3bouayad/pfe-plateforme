              "host": ["{{baseUrl}}"], "path": ["api", "admin", "audit"],
              "query": [{ "key": "action", "value": "DOCUMENT_SUPPRIME" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const documentId = Number(pm.collectionVariables.get('documentId'));",
                  "const entree = pm.response.json().content.find(e => e.cible === 'Document#' + documentId);",
                  "pm.test('entree trouvee pour ce document', () => pm.expect(entree).to.not.be.undefined);"
                ]
              }
            }
          ]
        }
      ]
    }
